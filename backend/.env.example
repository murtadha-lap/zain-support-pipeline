# Copy to backend/.env (never commit .env). All values optional for local dev.

# SQLite (default, local dev) or PostgreSQL:
DATABASE_URL=sqlite:///./zsp.db
# DATABASE_URL=postgresql+psycopg://zsp:zsp@localhost:5432/zsp

# JWT signing secret (HS256). CHANGE IN PRODUCTION (>= 32 random bytes).
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_DAYS=7

# Set true behind HTTPS so the zsp_token cookie gets the Secure flag.
COOKIE_SECURE=false

# CORS origin(s) of the frontend, comma separated (the Next.js rewrite makes it same-origin anyway).
FRONTEND_ORIGIN=http://localhost:3000

LOG_LEVEL=INFO

# Folder with train.jsonl (used by `python -m app.seed --demo`). Default: <repo>/data
# DATA_DIR=../data

# Provider API keys. The DB stores only the NAME of the env var (ModelConfig.api_key_env).
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=...
# VLLM_API_KEY=...   (only if you started vLLM with --api-key)
